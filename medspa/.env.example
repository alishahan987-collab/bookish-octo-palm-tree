# ---- Required for the live site ------------------------------------------
# Supabase (Project Settings → API). The service role key is secret: server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Your domain (used for emails, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Resend (resend.com). EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="MEDSPA Skincare & Body <appointments@yourdomain.com>"

# ---- Optional ------------------------------------------------------------
# NEXT_PUBLIC_SPA_TIMEZONE=America/New_York
# BOOKING_RATE_LIMIT=5

# ---- Local development without Supabase ----------------------------------
# Without the Supabase variables the site stores data in ./.data (development only).
# ADMIN_EMAIL=admin@medspa.local
# ADMIN_PASSWORD=choose-a-password
# ADMIN_SESSION_SECRET=long-random-string
