{
  "name": "dermatology-clinic-website",
  "version": "0.1.0",
  "private": true,
  "description": "Premium dermatology & aesthetic clinic website with booking system and admin CMS (Next.js + Supabase).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:live": "LIVE=1 playwright test --project live --trace off",
    "db:seed": "tsx scripts/seed-supabase.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/speed-insights": "^2.1.0",
    "framer-motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
