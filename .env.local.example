# ── Supabase (leave empty to run in demo mode) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in clinic alert emails)
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_CLINIC_TIMEZONE=Asia/Karachi

# ── Email via Resend (https://resend.com) ──────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Clinic <appointments@yourclinic.com>"
EMAIL_FROM=
# Optional fallback for new-booking alerts (Admin → Contact → booking alert email takes priority)
CLINIC_ALERT_EMAIL=

# ── WhatsApp Business Platform (Cloud API) ─────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
# Names of templates approved in Meta Business Manager (4 body variables: name, treatment, date/time, reference)
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_ACCEPTED=
WHATSAPP_TEMPLATE_REJECTED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_TEMPLATE_RESCHEDULED=
WHATSAPP_TEMPLATE_CLINIC_ALERT=
